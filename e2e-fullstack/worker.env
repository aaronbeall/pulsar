# Settings for the Worker in the full-stack e2e run (npm run test:e2e:fullstack). Nothing here
# is a real secret: OpenAI is pointed at a dead address and Stripe at e2e-fullstack/fake-stripe.mjs.
BETTER_AUTH_SECRET=e2e-only-not-a-secret-0123456789abcdef
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret
AUTH_ORIGINS=http://localhost:8788
# Email sign-in for test accounts (worker/auth.ts); only works on localhost.
E2E_EMAIL_SIGNIN=1
# Hosted AI is on, but only tester accounts get replies (recorded ones). Anyone else's call
# goes to a dead address and fails, so nothing can reach OpenAI.
OPENAI_API_KEY=sk-e2e-not-a-real-key
OPENAI_URL=http://127.0.0.1:9/v1/chat/completions
AI_MODEL=gpt-5-mini
AI_DAILY_BUDGET_USD=10
TESTER_EMAILS=tester-1@e2e.test,tester-2@e2e.test,tester-3@e2e.test,tester-4@e2e.test,tester-5@e2e.test
STRIPE_SECRET_KEY=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_e2e
STRIPE_API_BASE=http://127.0.0.1:8790
STRIPE_PRICE_MONTHLY=price_e2e_month
STRIPE_PRICE_YEARLY=price_e2e_year
