// Cloudflare Worker that serves the whole site: the homepage at /, the app at /app/, and
// (later) the API at /api/. Static files come from the Vite build in dist/; the Worker only
// runs for requests that don't match a file. See README.md "Deploying".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Missing paths fall through to the Worker, which serves the app's page for app routes.
    "not_found_handling": "none"
  },
  // workers.dev URL plus a preview URL per uploaded version (used for PR previews).
  "workers_dev": true,
  "preview_urls": true,
  // Production domain. Its DNS must be on this Cloudflare account; deploy attaches it and
  // issues the certificate.
  "routes": [{ "pattern": "pulsarworkouts.app", "custom_domain": true }],
  "observability": { "enabled": true },
  // Accounts and sessions (Better Auth), later plans and AI usage. No workout data.
  // No database_id: Wrangler finds (or creates) the database by name.
  "d1_databases": [
    { "binding": "DB", "database_name": "pulsar", "migrations_dir": "worker/migrations" }
  ],
  "vars": {
    // Origins where Google sign-in is offered: each needs <origin>/api/auth/callback/google
    // registered in the Google OAuth client. localhost always works. Comma-separated.
    "AUTH_ORIGINS": "https://pulsarworkouts.app",
    // Hosted Pulsar AI (worker/ai/). Allowances and prices are in worker/ai/plans.ts.
    "AI_MODEL": "gpt-5-mini",
    // Daily spend across all accounts before hosted AI turns itself off until tomorrow (UTC).
    "AI_DAILY_BUDGET_USD": "10",
    // Stripe price ids for Pulsar AI ($3.99/month, $29.99/year). Test-mode ids until launch.
    "STRIPE_PRICE_MONTHLY": "price_1UaEg4Ru7wLB1EixsMo5hCxg",
    "STRIPE_PRICE_YEARLY": "price_1UaEgzRu7wLB1EixjkEftQEi"
  },
  // Secrets (wrangler secret put, or .dev.vars locally): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, OPENAI_API_KEY, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET. See README "Deploying".

  // PR previews (`wrangler preview`, one Cloudflare Preview per PR). Nothing here is inherited
  // from production: previews use the staging database, staging's secrets (passed by the
  // workflow from STAGING_* GitHub secrets) and Stripe test mode, and sign in through staging.
  "previews": {
    // Previews need the database's id (Wrangler doesn't look it up by name for them). It's
    // pulsar-staging, which the first PR run created; recreating it means updating both ids.
    "d1_databases": [
      { "binding": "DB", "database_name": "pulsar-staging", "database_id": "371bcacd-07b5-4f56-8fb4-9a09baa7b98f", "migrations_dir": "worker/migrations" }
    ],
    "vars": {
      // Preview addresses are <name>-pulsar.<account>.workers.dev; they can't each be
      // registered with Google, so sign-in goes through staging (AUTH_PROXY_URL).
      "AUTH_ORIGINS": "https://*.metamodernmonkey.workers.dev",
      "AUTH_PROXY_URL": "https://staging.pulsarworkouts.app",
      "AI_MODEL": "gpt-5-mini",
      "AI_DAILY_BUDGET_USD": "2",
      // Always Stripe test mode.
      "STRIPE_PRICE_MONTHLY": "price_1UaEg4Ru7wLB1EixsMo5hCxg",
      "STRIPE_PRICE_YEARLY": "price_1UaEgzRu7wLB1EixjkEftQEi"
    }
  },

  "env": {
    // Staging: `wrangler deploy --env staging` deploys the separate Worker "pulsar-staging" at
    // staging.pulsarworkouts.app. It shares its database and secrets with PR previews, and is
    // the fixed address Google (sign-in callback) and Stripe (test webhook) talk to.
    "staging": {
      "routes": [{ "pattern": "staging.pulsarworkouts.app", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "pulsar-staging", "database_id": "371bcacd-07b5-4f56-8fb4-9a09baa7b98f", "migrations_dir": "worker/migrations" }
      ],
      "vars": {
        "AUTH_ORIGINS": "https://staging.pulsarworkouts.app",
        // Staging is the proxy itself, so its own sign-ins skip it; it's set so that staging
        // can finish previews' sign-ins.
        "AUTH_PROXY_URL": "https://staging.pulsarworkouts.app",
        "AI_MODEL": "gpt-5-mini",
        "AI_DAILY_BUDGET_USD": "2",
        "STRIPE_PRICE_MONTHLY": "price_1UaEg4Ru7wLB1EixsMo5hCxg",
        "STRIPE_PRICE_YEARLY": "price_1UaEgzRu7wLB1EixjkEftQEi"
      }
    }
  }
}
